{
  "$schema": "https://opencode.ai/config.json",
  "provider": {
    "Lemonade": {
      "name": "Lemonade Server (local)",
      "npm": "@ai-sdk/openai-compatible",
      "models": {
        "DeepSeek-Qwen3-8B-GGUF": {"name": "DeepSeek Qwen3 8B (local)"},
        "GLM-4.7-Flash-GGUF": {"name": "GLM-4.7-Flash-GGUF (local)"},
        "LMX-Omni-52B-Halo": {"name": "LMX Omni 52B (local)"},
        "Qwen3.5-4B-GGUF": {"name": "Qwen3.5-4B-GGUF (local control)"},
        "Qwen3-Coder-Next-GGUF": {"name": "Qwen3 Coder Next (local)"},
        "Qwen3-Coder-30B-A3B-Instruct-GGUF": {"name": "Qwen3 Coder 30B (local)"},
        "Qwen3.6-27B-FP16-vLLM": {"name": "Qwen3.6 27B FP16 vLLM (strictly resource-admitted)"},
        "Qwen3.6-35B-A3B-MTP-GGUF": {"name": "Qwen3.6 35B A3B MTP (local)"},
        "Qwen3.8-27B-GGUF": {"name": "Qwen3.8 27B dense reasoning (local)"}
      }
    }
  },
  "permission": {
    "*": "allow",
    "external_directory": {"/home/david/**": "allow"},
    "webfetch": "deny",
    "websearch": "deny",
    "bash": {
      "*": "allow",
      "/home/david/agent-ecosystem/scripts/install-package *": "allow",
      "sudo -n /usr/local/sbin/agent-package-install *": "allow",
      "sudo *": "deny",
      "su *": "deny",
      "rm *": "deny",
      "shred *": "deny",
      "git -C /home/david/personal_projects/pigen push*": "allow",
      "git push*": "deny",
      "systemctl *": "deny",
      "apt *": "deny",
      "apt-get *": "deny",
      "snap *": "deny"
    }
  }
}
