{
  "backend": "cointos.backend_llama",
  "lemonade": "http://127.0.0.1:13305",
  "snapshots": "/dev/shm/cointos-contexts",
  "disk_snapshots": "~/.cache/cointos/contexts",
  "server_cgroup": "/sys/fs/cgroup/inference.slice",
  "port": 4200,
  "tick_seconds": 1,
  "model_check_seconds": 5,
  "keepalive_seconds": 10,
  "work_model": "Qwen3.8-27B-GGUF",
  "front_model": "Qwen3.5-4B-GGUF",
  "models": {
    "Qwen3.8-27B-GGUF": {
      "ctx_size": 262144,
      "lanes": 2,
      "memory_gb": 39,
      "args": "--batch-size 512 --ubatch-size 128 --poll 0 --prio -1 --spec-type draft-mtp",
      "weights_gb": 17.5
    },
    "Qwen3.5-4B-GGUF": {
      "ctx_size": 65536,
      "lanes": 2,
      "memory_gb": 7,
      "args": "--batch-size 512 --ubatch-size 128 --poll 0 --prio -1",
      "weights_gb": 2.9
    }
  },
  "classes": [
    "coin",
    "user",
    "background"
  ],
  "reserved_lanes": [
    {
      "model": "Qwen3.5-4B-GGUF",
      "lane": 1,
      "classes": [
        "coin"
      ]
    }
  ],
  "scheduler": {
    "chunk_tokens": 96,
    "read_chunk_tokens": 1024,
    "slice_seconds": 30,
    "yield_grace_seconds": 15,
    "max_thought_tokens": 16384,
    "shared_prefix_tokens": 4096
  },
  "memory": {
    "reserve_gb": 24,
    "agent_memory_gb": 1,
    "agent_limit_gb": 8,
    "max_psi": 1.0,
    "distress_seconds": 30,
    "disk_snapshots_gb": 100
  },
  "checks": {
    "idle_lane_seconds": 5,
    "preempt_seconds": 15,
    "starve_seconds": 120,
    "agent_silent_seconds": 30,
    "max_identical_thoughts": 3,
    "exit_grace_seconds": 30
  },
  "spawner": {
    "max_agents": 4,
    "interval_seconds": 5,
    "max_runs_per_task": 5,
    "survey_every_seconds": 21600,
    "maintenance_every_seconds": 21600,
    "maintenance_project": "CointOS",
    "user_quiet_seconds": 120
  },
  "projects": [
    {
      "name": "sandbox",
      "path": "~/Projects/cointos-sandbox",
      "main_branch": "main"
    }
  ],
  "history_length": 200,
  "coin": {
    "telegram_env": "~/.config/agent-ecosystem/telegram.env",
    "history_messages": 20,
    "max_tool_rounds": 8,
    "alert_poll_seconds": 5,
    "reply_seconds": 12,
    "reply_tokens": 500,
    "deep_turn_seconds": 1800,
    "finishing_rounds": 3
  },
  "viewers": {
    "max_viewers": 4,
    "terminal": [
      "gnome-terminal",
      "--"
    ],
    "opening_seconds": 15
  },
  "dashboard": {
    "live_hz": 10,
    "live_chars": 600
  }
}
