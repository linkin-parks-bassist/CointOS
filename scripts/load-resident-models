#!/usr/bin/env bash
set -euo pipefail

for attempt in $(seq 1 60); do
    if /usr/bin/lemonade status >/dev/null 2>&1; then
        break
    fi
    if [ "$attempt" -eq 60 ]; then
        echo "Lemonade did not become ready within 120 seconds" >&2
        exit 1
    fi
    sleep 2
done

/usr/bin/lemonade load Qwen3.8-27B-GGUF \
    --pinned --ctx-size 131072 --merge-args=true --llamacpp-args '--parallel 4'
/usr/bin/lemonade load Qwen3-Coder-30B-A3B-Instruct-GGUF \
    --ctx-size 65536 --merge-args=true --llamacpp-args '--parallel 2'
