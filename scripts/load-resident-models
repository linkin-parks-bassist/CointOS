#!/usr/bin/env bash
set -euo pipefail

for attempt in $(seq 1 60); do
    if /usr/bin/lemonade status >/dev/null 2>&1; then
        break
    fi
    if [ "$attempt" -eq 60 ]; then
        echo "Lemonade did not become ready within 120 seconds" >&2
        exit 1
    fi
    sleep 2
done

/usr/bin/lemonade config set max_loaded_models=2

# The only pinned model is the small chatbot/router/emergency control plane. One
# additional unpinned work model may be selected dynamically for agent work.
/usr/bin/lemonade load Qwen3.5-4B-GGUF \
    --save-options --pinned --ctx-size 32768 --merge-args=true \
    --llamacpp-args '--parallel 2 --batch-size 512 --ubatch-size 128 --poll 0 --prio -1'
