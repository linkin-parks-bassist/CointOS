#!/usr/bin/env python3
"""Upgrade a stopped daemon's ledger to the current schema, once, in place.

The runtime assumes the current schema and carries no compatibility branches; this script is
where older ledgers are brought up to it. `scripts/install` runs it while the daemon is stopped,
with the installed runtime's project registry beside the ledger. It is idempotent.

Current schema, from the stored-status one:
- A queue record holds what is wanted plus one terminal fact, `done` ({at, commit?, via?}).
  Its stored `status`, `decompose`, `report`, `hash` and `commit` go: where it stands is derived
  from its tasks. A record replaced by children keeps only `replaced_by`. Records gain
  `version` (1); tasks made for the current version gain `record_version` 1, stale ones 0, so a
  failed item still awaits its manager and a finished decomposition still speaks for it.
- A garden's `record_hash` (a tree-health identity) becomes `health_hash`; other tasks' go.
- Dependency names are cleaned of markup; human `held_by` labels become "user".
- The worker's `.work-report.md` is retired (the receipt is its account): accepted hidden test
  packets that carry one get a child commit without it, recorded as the packet and kept under
  its archive ref; a worker branch that is not running gets a commit removing it, and a
  reviewed one waits to be finished again on that commit.
"""
import json
import os
import subprocess
import sys
import tempfile
from pathlib import Path

REPORT = ".work-report.md"
NO_DEPENDENCY = {"none", "nothing", "n/a", "-"}


def git(repo, *args, env=None) -> subprocess.CompletedProcess:
    return subprocess.run(["git", "-C", str(repo), *args], capture_output=True, text=True,
                          env={**os.environ, **(env or {})})


def has_report(repo, commit: str) -> bool:
    return git(repo, "cat-file", "-e", f"{commit}:{REPORT}").returncode == 0


def without_report(repo, commit: str) -> str:
    """A child of `commit` whose tree lacks the report."""
    with tempfile.TemporaryDirectory() as temp:
        env = {"GIT_INDEX_FILE": str(Path(temp) / "index")}
        git(repo, "read-tree", commit, env=env)
        git(repo, "rm", "-q", "--cached", "--", REPORT, env=env)
        tree = git(repo, "write-tree", env=env).stdout.strip()
    made = git(repo, "-c", "user.name=CointOS", "-c", "user.email=cointos@localhost",
               "commit-tree", tree, "-p", commit, "-m", "Test packet without its work report")
    if made.returncode:
        raise SystemExit(f"cannot strip {REPORT} from {commit} in {repo}: {made.stderr.strip()}")
    return made.stdout.strip()


def dependency(name: str) -> str:
    name = name.strip().strip("`*()[]").strip().rstrip(".;").strip("`*()[]").strip()
    return "" if name.lower() in NO_DEPENDENCY else name


def upgrade_records(ledger: dict) -> None:
    tasks = ledger.get("tasks", {})
    for key, record in ledger.get("queue", {}).items():
        if "version" in record:
            continue
        status, decompose = record.pop("status", "queued"), record.pop("decompose", False)
        commit = record.pop("commit", None)
        record.pop("report", None)
        record.pop("hash", None)
        record["version"] = 1
        record["depends"] = list(dict.fromkeys(n for n in (dependency(d) for d in record.get("depends", [])) if n))
        holder = record.get("held_by")
        if holder and ":" not in holder:
            record["held_by"] = "user"
        if status == "done" and not record.get("replaced_by"):
            item = tasks.get(key) or {}
            record["done"] = {"at": item.get("updated_at", 0), **({"commit": commit} if commit else {}),
                              **({"via": item["acceptance"]["via"]} if item.get("acceptance") else {})}
        project, name = record["project"], record["item"]
        for task_id, kind in ((key, None), (f"{project}:decompose-{name}", "decompose")):
            task = tasks.get(task_id)
            if task is None:
                continue
            active = task["status"] in ("waiting", "running", "review")
            if active:
                current = True
            elif status == "done":
                current = kind is None
            elif status == "blocked":
                current = kind is None or not decompose
            else:
                current = False
            task["record_version"] = 1 if current else 0
    for task in tasks.values():
        old = task.pop("record_hash", None)
        if task["kind"] == "garden":
            task.setdefault("health_hash", old)
        task.setdefault("record_version", None)


def strip_reports(ledger: dict, registry: list[dict]) -> None:
    paths = {project["name"]: project["path"] for project in registry}
    tasks = ledger.get("tasks", {})
    for key, record in ledger.get("queue", {}).items():
        done = record.get("done") or {}
        repo = paths.get(record["project"])
        if record.get("stage") != "test-contract" or not done.get("commit") or not repo or not Path(repo).is_dir():
            continue
        if git(repo, "cat-file", "-e", done["commit"]).returncode or not has_report(repo, done["commit"]):
            continue
        stripped = without_report(repo, done["commit"])
        git(repo, "update-ref", f"refs/cointos/archive/packets/{record['item']}", stripped)
        done["commit"] = stripped
        print(f"{key}: test packet without its work report is {stripped[:12]}")
    for task in tasks.values():
        worktree = task.get("worktree")
        if (task["kind"] != "item" or task["status"] not in ("waiting", "review") or not task.get("branch")
                or not worktree or not Path(worktree).is_dir() or not has_report(worktree, "HEAD")
                or git(worktree, "status", "--porcelain").stdout.strip()):
            continue
        git(worktree, "rm", "-q", "--", REPORT)
        git(worktree, "-c", "user.name=CointOS", "-c", "user.email=cointos@localhost",
            "commit", "-q", "-m", "Retire the work report: the completion receipt is the worker's account")
        if task["status"] == "review":
            task.update(status="waiting", receipt=None,
                        note="its branch dropped the retired work report; finish again on the new commit")
        print(f"{task['id']}: removed {REPORT} from its branch")


def upgrade(ledger: dict, registry: list[dict]) -> dict:
    upgrade_records(ledger)
    strip_reports(ledger, registry)
    ledger.pop("incidents", None)
    return ledger


def main(path: Path) -> None:
    if not path.exists():
        return
    registry_path = path.parent.parent / "config/projects.json"
    registry = json.loads(registry_path.read_text()) if registry_path.exists() else []
    registry = registry.get("projects", registry) if isinstance(registry, dict) else registry
    ledger = upgrade(json.loads(path.read_text()), registry)
    temporary = path.with_name(f".{path.name}.upgrade")
    temporary.write_text(json.dumps(ledger, indent=1, sort_keys=True) + "\n")
    os.replace(temporary, path)
    print(f"upgraded {path}")


if __name__ == "__main__":
    main(Path(sys.argv[1]))
