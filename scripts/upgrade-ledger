#!/usr/bin/env python3
"""Upgrade a stopped daemon's ledger to the current schema, once, in place.

The runtime assumes the current schema and carries no compatibility branches; this script is
where older ledgers are brought up to it. `scripts/install` runs it while the daemon is stopped,
with the installed runtime's project registry beside the ledger. It is idempotent.

Current schema, from the stored-status one:
- A queue record holds what is wanted plus one terminal fact, `done` ({at, commit?, via?}).
  Its stored `status`, `decompose`, `report`, `hash` and `commit` go: where it stands is derived
  from its tasks. A record replaced by children keeps only `replaced_by`. Records gain
  `version` (1); tasks made for the current version gain `record_version` 1, stale ones 0, so a
  legacy assignment evidence retains its version before recovery ownership is migrated.
- A garden's `record_hash` (a tree-health identity) becomes `health_hash`; other tasks' go.
- Dependency names are cleaned of markup; human `held_by` labels become "user".
  Same-project qualified aliases become local names even in current versioned records;
  matching brief metadata changes spelling, without revising assignments or task evidence.
- Unscoped Coin snapshots are discarded: per-user cache owners replace them. History stays.
- The worker's `.work-report.md` is retired (the receipt is its account): accepted hidden test
  packets that carry one get a child commit without it, recorded as the packet and kept under
  its archive ref; a worker branch that is not running gets a commit removing it, and a
  reviewed one waits to be finished again on that commit.
"""
import json
import os
import re
import subprocess
import sys
import tempfile
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parents[1]))
from cointos import config as configuration, dependencies

REPORT = ".work-report.md"
NO_DEPENDENCY = {"none", "nothing", "n/a", "-"}


def git(repo, *args, env=None) -> subprocess.CompletedProcess:
    return subprocess.run(["git", "-C", str(repo), *args], capture_output=True, text=True,
                          env={**os.environ, **(env or {})})


def has_report(repo, commit: str) -> bool:
    return git(repo, "cat-file", "-e", f"{commit}:{REPORT}").returncode == 0


def without_report(repo, commit: str) -> str:
    """A child of `commit` whose tree lacks the report."""
    with tempfile.TemporaryDirectory() as temp:
        env = {"GIT_INDEX_FILE": str(Path(temp) / "index")}
        git(repo, "read-tree", commit, env=env)
        git(repo, "rm", "-q", "--cached", "--", REPORT, env=env)
        tree = git(repo, "write-tree", env=env).stdout.strip()
    made = git(repo, "-c", "user.name=CointOS", "-c", "user.email=cointos@localhost",
               "commit-tree", tree, "-p", commit, "-m", "Test packet without its work report")
    if made.returncode:
        raise SystemExit(f"cannot strip {REPORT} from {commit} in {repo}: {made.stderr.strip()}")
    return made.stdout.strip()


def dependency(name: str) -> str:
    name = name.strip().strip("`*()[]").strip().rstrip(".;").strip("`*()[]").strip()
    return "" if name.lower() in NO_DEPENDENCY else name


def upgrade_records(ledger: dict) -> None:
    tasks = ledger.get("tasks", {})
    for key, record in ledger.get("queue", {}).items():
        if "version" in record:
            continue
        status, decompose = record.pop("status", "queued"), record.pop("decompose", False)
        commit = record.pop("commit", None)
        record.pop("report", None)
        record.pop("hash", None)
        record["version"] = 1
        record["depends"] = list(dict.fromkeys(n for n in (dependency(d) for d in record.get("depends", [])) if n))
        holder = record.get("held_by")
        if holder and ":" not in holder:
            record["held_by"] = "user"
        if status == "done" and not record.get("replaced_by"):
            item = tasks.get(key) or {}
            record["done"] = {"at": item.get("updated_at", 0), **({"commit": commit} if commit else {}),
                              **({"via": item["acceptance"]["via"]} if item.get("acceptance") else {})}
        project, name = record["project"], record["item"]
        for task_id, kind in ((key, None), (f"{project}:decompose-{name}", "decompose")):
            task = tasks.get(task_id)
            if task is None:
                continue
            active = task["status"] in ("waiting", "running", "review")
            if active:
                current = True
            elif status == "done":
                current = kind is None
            elif status == "blocked":
                current = kind is None or not decompose
            else:
                current = False
            task["record_version"] = 1 if current else 0
    for task in tasks.values():
        old = task.pop("record_hash", None)
        if task["kind"] == "garden":
            task.setdefault("health_hash", old)
        task.setdefault("record_version", None)


def upgrade_recovery(ledger: dict) -> None:
    """Work identity owns recovery; obsolete execution-task chains become history."""
    if ledger.get('frontier_version') == 1:
        return
    tasks = ledger.get('tasks', {})
    origins = {key: task.get('record') or key for key, task in tasks.items()}
    for task in tasks.values():
        if task['kind'] == 'decompose':
            task['previous_kind'] = 'decompose'
            owned = task.get('record') or f"{task['place']}:{task['item']}"
            task.update(kind='operator', role='operator', abilities=['standard', 'control', 'network'],
                        repair_origin={'task': owned, 'version': task.get('record_version')},
                        record=None, rank=[1, *task.get('rank', [3])[1:]])
        if task.get('repair_origin'):
            origin = task['repair_origin']
            origin['task'] = origins.get(origin['task'], origin['task'])
            if task['status'] in ('done', 'failed'):
                task['former_repair_origin'] = task.pop('repair_origin')
            else:
                if task.get('session'):
                    task.setdefault('previous_sessions', []).append(task['session'])
                task.update(session=None, recovery_note='Recovery now has one controller with queue and infrastructure controls.')
                task.pop('system_context', None)
                task.pop('tool_context', None)
    owners = {}
    for task in sorted(tasks.values(), key=lambda t: (t.get('previous_kind') == 'decompose', t.get('created_at', 0))):
        origin = task.get('repair_origin')
        if not origin:
            continue
        key = (origin['task'], origin['version'])
        if key in owners:
            task.update(status='failed', agent=None, former_repair_origin=task.pop('repair_origin'),
                        recovery_owner=owners[key], note='Recovery is owned by ' + owners[key])
        else:
            owners[key] = task['id']
    ledger['frontier_version'] = 1


def dependency_aliases(ledger: dict) -> list[tuple[dict, list[str], str]]:
    """Preflight every record before mutation or Git effects; aliases change spelling, not work."""
    changes = []
    for record in ledger.get("queue", {}).values():
        project, brief = record["project"], record["brief"]
        names = record.get("depends", [])
        canonical = dependencies.canonical(project, [n for n in (dependency(name) for name in names) if n])
        rows = brief.splitlines(keepends=True)
        metadata = [(index, row) for index, row in enumerate(rows)
                    if re.match(r"\**Depends on:\**", row.strip(), re.IGNORECASE)]
        written = [dependencies.canonical(project, dependencies.depends(row)) for _, row in metadata]
        qualified = any(":" in name for name in names + [name for _, row in metadata
                                                        for name in dependencies.depends(row)])
        if not qualified:
            continue
        if any(set(named) != set(canonical) for named in written):
            raise ValueError("qualified dependency metadata disagrees with its brief")
        text = "Depends on: " + (", ".join(canonical) or "none")
        for index, row in metadata:
            ending = row[len(row.rstrip('\r\n')):]
            rows[index] = text + ending
        if not metadata:
            ending = next((row[len(row.rstrip('\r\n')):] for row in rows
                           if row.endswith(('\r', '\n'))), '\n')
            rows.insert(0, text + ending)
        changes.append((record, canonical, ''.join(rows)))
    return changes


def strip_reports(ledger: dict, registry: list[dict]) -> None:
    paths = {project["name"]: project["path"] for project in registry}
    tasks = ledger.get("tasks", {})
    for key, record in ledger.get("queue", {}).items():
        done = record.get("done") or {}
        repo = paths.get(record["project"])
        if record.get("stage") != "test-contract" or not done.get("commit") or not repo or not Path(repo).is_dir():
            continue
        if git(repo, "cat-file", "-e", done["commit"]).returncode or not has_report(repo, done["commit"]):
            continue
        stripped = without_report(repo, done["commit"])
        git(repo, "update-ref", f"refs/cointos/archive/packets/{record['item']}", stripped)
        done["commit"] = stripped
        print(f"{key}: test packet without its work report is {stripped[:12]}")
    for task in tasks.values():
        worktree = task.get("worktree")
        if (task["kind"] != "item" or task["status"] not in ("waiting", "review") or not task.get("branch")
                or not worktree or not Path(worktree).is_dir() or not has_report(worktree, "HEAD")
                or git(worktree, "status", "--porcelain").stdout.strip()):
            continue
        git(worktree, "rm", "-q", "--", REPORT)
        git(worktree, "-c", "user.name=CointOS", "-c", "user.email=cointos@localhost",
            "commit", "-q", "-m", "Retire the work report: the completion receipt is the worker's account")
        if task["status"] == "review":
            task.update(status="waiting", receipt=None,
                        note="its branch dropped the retired work report; finish again on the new commit")
        print(f"{task['id']}: removed {REPORT} from its branch")


def upgrade(ledger: dict, registry: list[dict]) -> dict:
    aliases = dependency_aliases(ledger)
    if not ledger.get('frontier_version') and any(
            t['status'] == 'running' and (t['kind'] == 'decompose' or t.get('repair_origin'))
            for t in ledger.get('tasks', {}).values()):
        raise ValueError('pause construction agents before replacing recovery ownership')
    upgrade_records(ledger)
    upgrade_recovery(ledger)
    for record, names, brief in aliases:
        record.update(depends=names, brief=brief)
    strip_reports(ledger, registry)
    # Old blocked receipts waited for an integrator assessment. Route inactive
    # assessments to their actual repair owner without discarding any artifacts.
    # Preserve an assessment already running; its own receipt will finish it.
    for worker in ledger.get("tasks", {}).values():
        if (worker["kind"] != "item" or worker["status"] != "review"
                or (worker.get("receipt") or {}).get("disposition") != "blocked"):
            continue
        integrations = [t for t in ledger["tasks"].values()
                        if t["kind"] == "integrate" and t.get("worker") == worker["id"]
                        and t["status"] in ("waiting", "running")]
        if any(t["status"] == "running" for t in integrations):
            continue
        worker.update(status="failed", agent=None, note="blocked receipt awaits recovery controller")
        for integration in integrations:
            integration.update(status="failed", agent=None,
                               note="blocked receipt routed directly to recovery controller")
    ledger.pop("incidents", None)
    for name in [n for n, snapshot in ledger.get("snapshots", {}).items() if snapshot.get("owner") == "coin"]:
        del ledger["snapshots"][name]
    return ledger


def main(path: Path) -> None:
    absent = object()
    previous = configuration.read_owned_json(path, absent)
    if previous is absent:
        return
    configuration.validate_ledger(previous)
    registry_path = path.parent.parent / "config/projects.json"
    registry = configuration.read_owned_json(registry_path, [])
    registry = registry.get("projects") if isinstance(registry, dict) else registry
    registry = configuration.project_entries(registry)
    ledger = upgrade(previous, registry)
    temporary = path.with_name(f".{path.name}.upgrade")
    temporary.write_text(json.dumps(ledger, indent=1, sort_keys=True) + "\n")
    os.replace(temporary, path)
    print(f"upgraded {path}")


if __name__ == "__main__":
    main(Path(sys.argv[1]))
