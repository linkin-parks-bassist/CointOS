#!/usr/bin/env bash
set -euo pipefail

# One operator boundary for the complete user-session CointOS generation.
# Keep triggers in the same stop transaction so they cannot reactivate a
# mixture of old and newly installed processes during an upgrade/restart.
long_running=(
  agent-models.service
  agent-inference-proxy.service
  agent-resource-guard.service
  agent-telegram.service
  agent-control-worker.service
  agent-notifier.service
)
triggers=(
  agent-ecosystem.path
  agent-ecosystem.timer
  agent-watchdog.timer
)
oneshots=(
  agent-ecosystem.service
  agent-watchdog.service
)
all_units=("${triggers[@]}" "${oneshots[@]}" "${long_running[@]}")
start_units=("${long_running[@]}" "${triggers[@]}")

usage() {
  echo "usage: cointos-system {start|stop|restart|status}" >&2
  exit 2
}

action=${1:-}
[[ $# -eq 1 ]] || usage

case "$action" in
  start)
    systemctl --user daemon-reload
    if ! systemctl --user start "${start_units[@]}"; then
      systemctl --user stop "${all_units[@]}" || true
      echo "CointOS start failed; the complete user system was stopped." >&2
      exit 1
    fi
    ;;
  stop)
    systemctl --user stop "${all_units[@]}"
    ;;
  restart)
    systemctl --user stop "${all_units[@]}"
    systemctl --user daemon-reload
    if ! systemctl --user start "${start_units[@]}"; then
      systemctl --user stop "${all_units[@]}" || true
      echo "CointOS restart failed; the complete user system was stopped." >&2
      exit 1
    fi
    ;;
  status)
    systemctl --user --no-pager --plain status "${start_units[@]}"
    ;;
  *) usage ;;
esac
