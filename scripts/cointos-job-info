#!/usr/bin/env python3
"""Show durable state and live runner identity for one managed CointOS job."""

import argparse
import json
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parents[1]))

from ecosystem.job_inspection import load_job, summarize_job


def main() -> None:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("job_id", help="managed task ID, for example task-abc123")
    parser.add_argument("--root", type=Path, default=Path.home() / ".CointOS")
    parser.add_argument("--json", action="store_true", help="emit machine-readable JSON")
    args = parser.parse_args()

    try:
        summary = summarize_job(args.root, load_job(args.root, args.job_id))
    except (OSError, ValueError, json.JSONDecodeError) as error:
        parser.exit(2, f"cointos-job-info: {error}\n")

    if args.json:
        print(json.dumps(summary, indent=2, sort_keys=True))
        return

    print(f"{summary['id']}: state={summary['state']} terminal={str(summary['terminal']).lower()}")
    print(f"process_exit: clean={str(summary['clean_process_exit']).lower()} "
          f"exit_code={summary['exit_code']} close={((summary['runner_close'] or {}).get('state'))}")
    runner = summary["runner"]
    print(f"runner: state={runner['state']} pid={runner['pid']} "
          f"identity_matches={runner['identity_matches']}")
    print(f"model: {summary['model']}  session: {summary['session']}")
    print(f"attempts: {summary['attempts']}  generation: {summary['generation']}")
    print(f"created: {summary['created_at']}")
    print(f"started: {summary['started_at']}")
    print(f"updated: {summary['updated_at']}")
    print(f"completed: {summary['completed_at']}")
    if summary["budget_usage"] is not None:
        print("usage: " + json.dumps(summary["budget_usage"], sort_keys=True))
    if summary["error"]:
        print(f"error: {summary['error']}", file=sys.stderr)
    print(f"log: {summary['output_log']}")


if __name__ == "__main__":
    main()
