#!/usr/bin/env python3
"""Inspect, qualify, or reconcile CointOS backend parallel profiles."""

from __future__ import annotations

import argparse
import json
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parents[1]))

from ecosystem import (backend_profile_policy, backend_profile_scheduler,
                       backend_profiles, cli, models, resource_control)


def _observed_model(root: Path, model_id: str):
    health = resource_control.lemonade_health()
    resident = resource_control.model_residency_status(health, model_id)
    if resident["state"] != "live":
        raise RuntimeError("model is not observed live")
    profile = backend_profiles.observed_profile(resident["record"])
    inventory = models.snapshot(root)
    backend_profiles.require_qualified_allocation(inventory, profile)
    model = next(item for item in inventory["models"]
                 if item.get("id") == model_id)
    return profile, model


def status(root: Path) -> dict:
    qualifications = backend_profile_policy.load_qualifications(root)
    inventory = models.snapshot(root)
    health = resource_control.lemonade_health()
    capacity = backend_profile_scheduler.capacity_state(root)
    records = []
    for model in inventory.get("models", []):
        if type(model) is not dict or model.get("loaded") is not True:
            continue
        name = model.get("id")
        resident = resource_control.model_residency_status(health, name)
        if resident["state"] != "live":
            continue
        item = {"model_id": name, "is_busy": resident["record"].get("is_busy"),
                "control_model": name == inventory.get("control_model")}
        if resident["record"].get("is_busy") is False:
            try:
                profile = backend_profiles.observed_profile(resident["record"])
                backend_profiles.require_qualified_allocation(inventory, profile)
                item.update(parallel_sequences=profile["parallel_sequences"],
                            context_tokens_per_sequence=profile[
                                "context_tokens_per_sequence"],
                            qualified_ceiling=backend_profile_policy.qualified_ceiling(
                                qualifications, profile, model))
            except (KeyError, RuntimeError, ValueError) as error:
                item["profile_error"] = str(error)
        records.append(item)
    transition = capacity.get("backend_profile_transition")
    return {"resource_mode": backend_profiles.resource_mode(root),
            "automation_enabled": (root / "state/backend-profile-automation.enabled").exists(),
            "fenced_transition": None if transition is None else {
                "model_id": transition.get("model_id"),
                "target_parallel_sequences": transition.get(
                    "target_parallel_sequences")},
            "models": records}


def qualify_current(root: Path, model_id: str, evidence: str) -> dict:
    if backend_profiles.resource_mode(root) != "normal":
        raise RuntimeError("resource mode is not normal")
    capacity = backend_profile_scheduler.capacity_state(root)
    if capacity.get("backend_profile_transition") is not None:
        raise RuntimeError("a backend profile transition is already fenced")
    profile, model = _observed_model(root, model_id)
    if model_id == models.snapshot(root).get("control_model"):
        raise RuntimeError("control model is not an ordinary work profile")
    if any(lease.get("model_id") == model_id
           and lease.get("state") not in {"released", "ready_for_revalidation"}
           for lease in capacity["leases"].values()):
        raise RuntimeError("model inference allocations have not parked")
    return backend_profile_policy.record_qualification(
        root, profile, model, evidence)


def enable_automation(root: Path) -> dict:
    current = status(root)
    if current["resource_mode"] != "normal" or current["fenced_transition"]:
        raise RuntimeError("backend profile automation is not safe to enable")
    qualified_work = [item for item in current["models"]
                      if item["control_model"] is False
                      and type(item.get("qualified_ceiling")) is int]
    if not qualified_work:
        raise RuntimeError("no exact work-model profile is qualified")
    marker = root / "state/backend-profile-automation.enabled"
    marker.parent.mkdir(parents=True, exist_ok=True)
    if not marker.exists():
        with marker.open("x", encoding="utf-8") as stream:
            stream.write(cli.now() + "\n")
    return {"automation_enabled": True,
            "qualified_models": [item["model_id"] for item in qualified_work]}


def disable_automation(root: Path) -> dict:
    marker = root / "state/backend-profile-automation.enabled"
    marker.unlink(missing_ok=True)
    return {"automation_enabled": False}


def resize_qualified(root: Path, model_id: str, parallel: int) -> dict:
    if type(parallel) is not int or parallel <= 0:
        raise ValueError("parallel must be a positive exact integer")
    profile, model = _observed_model(root, model_id)
    qualified = backend_profile_policy.qualified_ceiling(
        backend_profile_policy.load_qualifications(root), profile, model)
    if qualified is None or parallel > qualified:
        raise RuntimeError("target exceeds exact-profile qualification")
    return backend_profiles.reconfigure(root, model_id, parallel)


def main() -> None:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("command", choices=(
        "status", "plan", "qualify-current", "resize-qualified", "reconcile",
        "enable-automation", "disable-automation"))
    parser.add_argument("--root", type=Path, default=cli.ROOT,
                        help="CointOS runtime root (defaults to this installation)")
    parser.add_argument("--model", help="exact resident model ID for qualification")
    parser.add_argument("--evidence", help="concrete successful-run evidence")
    parser.add_argument("--parallel", type=int,
                        help="qualified physical backend sequence count")
    args = parser.parse_args()
    root = args.root.resolve()
    if args.command == "status":
        result = status(root)
    elif args.command == "plan":
        result = backend_profile_scheduler.plan_once(root)
    elif args.command == "qualify-current":
        if not args.model or not args.evidence:
            parser.error("qualify-current requires --model and --evidence")
        result = qualify_current(root, args.model, args.evidence)
    elif args.command == "resize-qualified":
        if not args.model or args.parallel is None:
            parser.error("resize-qualified requires --model and --parallel")
        result = resize_qualified(root, args.model, args.parallel)
    elif args.command == "enable-automation":
        result = enable_automation(root)
    elif args.command == "disable-automation":
        result = disable_automation(root)
    else:
        result = backend_profile_scheduler.reconcile_once(root)
    print(json.dumps(result, indent=2, sort_keys=True))


if __name__ == "__main__":
    main()
