#!/usr/bin/env bash
# Install CointOS to run from this checkout: systemd user units and `cointos` on PATH.
set -euo pipefail
root="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/.." && pwd)"
units="$HOME/.config/systemd/user"
mkdir -p "$units" "$HOME/.local/bin"
for unit in "$root"/systemd/*.service; do
  sed "s|@ROOT@|$root|g" "$unit" > "$units/$(basename "$unit")"
done
ln -sfn "$root/bin/cointos" "$HOME/.local/bin/cointos"
systemctl --user daemon-reload
systemctl --user enable cointosd.service cointos-coin.service
echo "installed from $root; start with: cointos up"
