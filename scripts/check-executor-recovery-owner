#!/usr/bin/env python3
"""Fast synthetic proof that recovery preserves an exact live executor owner."""

import json
import os
import sys
import tempfile
from pathlib import Path
from unittest.mock import patch

sys.path.insert(0, str(Path(__file__).resolve().parents[1]))

from ecosystem import cli
from ecosystem.executor import process_identity, recover_abandoned_jobs


def main() -> None:
    with tempfile.TemporaryDirectory() as temporary, \
            patch.object(cli, "ROOT", Path(temporary)):
        cli.initialize()
        owner = process_identity(os.getpid())
        path = cli.ROOT / "state/jobs/task-live-owner.json"
        original = {
            "id": "task-live-owner", "kind": "agent-task",
            "state": "reconciliation_required", "runner_generation": 4,
            "runner_phase": "close_intent", "worker_lease_id": "worker-live",
            "inference_lease_id": "inference-live",
            "runner_close_outcome": {
                "state": "reconciliation_required", "returncode": None,
                "process_group_alive": True,
            },
            "executor_owner_pid": owner["pid"],
            "executor_owner_start_ticks": owner["start_ticks"],
        }
        cli.atomic_json(path, original)
        with patch("ecosystem.executor._stop_recovered_runner") as stop:
            assert recover_abandoned_jobs() == 0
        stop.assert_not_called()
        assert json.loads(path.read_text(encoding="utf-8")) == original

        recycled = dict(original)
        recycled["executor_owner_start_ticks"] += 1
        cli.atomic_json(path, recycled)
        with patch("ecosystem.executor._stop_recovered_runner", return_value=None) as stop:
            assert recover_abandoned_jobs() == 1
        stop.assert_called_once()

    print("live executor ownership recovery proof: OK")


if __name__ == "__main__":
    main()
