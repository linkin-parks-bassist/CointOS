#!/usr/bin/env python3
"""Install the pinned CointOS V2 CLI and matching libraries."""
from pathlib import Path
import subprocess
import sys

root = Path(__file__).resolve().parents[1]
sys.path.insert(0, str(root))
from cointos.opencode import OPENCODE2, OPENCODE2_VERSION, require_opencode2

subprocess.run(['npm', 'install', '--prefix', str(Path(OPENCODE2).parent.parent.parent), '--no-audit', '--no-fund',
                f'@opencode/cli@{OPENCODE2_VERSION}', f'@opencode/client@{OPENCODE2_VERSION}',
                f'@opencode/plugin@{OPENCODE2_VERSION}'], check=True)
require_opencode2()
print(f'OpenCode {OPENCODE2_VERSION} installed; managed assets are ready.')
