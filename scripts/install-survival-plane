#!/usr/bin/env bash
# Install the permanent survival plane without activating it by default.
set -euo pipefail

usage() {
    echo "usage: scripts/install-survival-plane [--enable]" >&2
}

enable=false
case "$#" in
    0) ;;
    1)
        if [[ "$1" != "--enable" ]]; then
            usage
            exit 64
        fi
        enable=true
        ;;
    *)
        usage
        exit 64
        ;;
esac

install_root="${COINTELPROFESSIONAL_INSTALL_ROOT:-}"
if [[ -n "$install_root" && "$install_root" != /* ]]; then
    echo "COINTELPROFESSIONAL_INSTALL_ROOT must be absolute" >&2
    exit 64
fi
install_root="${install_root%/}"
if (( EUID != 0 )) && [[ -z "$install_root" ]]; then
    echo "install-survival-plane must run as root" >&2
    exit 77
fi

repository_directory="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
install_prefix="$install_root/usr/local/lib/cointelprofessional-survival"
releases_directory="$install_prefix/releases"
current_release="$install_prefix/current"
state_directory="$install_root/var/lib/cointelprofessional"
socket_directory="$install_root/run/cointelprofessional"
configuration_directory="$install_root/etc/cointelprofessional"
unit_directory="$install_root/etc/systemd/system"

command_group=cointelprofessional_command
spool_group=agent_ecosystem_io
gateway_user=cointelprofessional
user_manager=david

if ! getent group "$command_group" >/dev/null; then
    groupadd --system "$command_group"
fi
if ! getent group "$spool_group" >/dev/null; then
    groupadd --system "$spool_group"
fi

if account_record="$(getent passwd "$gateway_user")"; then
    IFS=: read -r account_name ignored_password account_uid account_gid \
        account_description account_home account_shell <<<"$account_record"
    if [[ "$account_name" != "$gateway_user" \
        || "$account_uid" == "0" \
        || "$account_home" != "/nonexistent" \
        || "$account_shell" != "/usr/sbin/nologin" \
        || "$(id -gn "$gateway_user")" != "$gateway_user" ]]; then
        echo "existing cointelprofessional account does not match the installation contract" >&2
        exit 1
    fi
else
    useradd --system --user-group --home-dir /nonexistent \
        --shell /usr/sbin/nologin "$gateway_user"
fi

usermod --append --groups "$command_group" "$gateway_user"
usermod --append --groups "$spool_group" "$user_manager"
gateway_uid="$(id -u "$gateway_user")"
user_manager_uid="$(id -u "$user_manager")"
user_manager_group="$(id -gn "$user_manager")"
if [[ ! "$gateway_uid" =~ ^[1-9][0-9]*$ || ! "$user_manager_uid" =~ ^[1-9][0-9]*$ ]]; then
    echo "survival-plane account identities are invalid" >&2
    exit 1
fi

release_digest() {
    local release_root="$1"
    local content_digest
    local content_line
    local digest_line
    local metadata
    local path
    local relative

    digest_line="$(
        (
            cd "$release_root"
            while IFS= read -r -d '' path; do
                relative="${path#./}"
                metadata="$(stat -c '%a:%u:%g' -- "$path")"
                if [[ -d "$path" ]]; then
                    printf 'directory\0%s\0%s\0' "$relative" "$metadata"
                elif [[ -f "$path" && ! -L "$path" ]]; then
                    content_line="$(sha256sum -- "$path")"
                    content_digest="${content_line%% *}"
                    printf 'file\0%s\0%s\0%s\0' \
                        "$relative" "$metadata" "$content_digest"
                else
                    echo "invalid release entry: $relative" >&2
                    exit 1
                fi
            done < <(find . -mindepth 0 -print0 | LC_ALL=C sort -z)
        ) | sha256sum
    )"
    printf '%s\n' "${digest_line%% *}"
}

validate_symbolic_link() {
    local target="$1"
    local link="$2"
    local existing_target

    if [[ -L "$link" ]]; then
        existing_target="$(readlink "$link")"
        if [[ "$existing_target" != "$target" ]]; then
            echo "existing symbolic link does not match installation contract: $link" >&2
            exit 1
        fi
        return 0
    fi
    if [[ -e "$link" ]]; then
        echo "existing path blocks transactional installation: $link" >&2
        exit 1
    fi
    return 0
}

ensure_symbolic_link() {
    local target="$1"
    local link="$2"

    validate_symbolic_link "$target" "$link"
    if [[ ! -L "$link" ]]; then
        ln -s "$target" "$link"
    fi
}

staging_directory=""
commit_directory=""
uncommitted_release=""
incident_destination_candidate=""
incident_destination_source=""
cleanup() {
    local active_target=""
    local candidate_target

    if [[ -L "$current_release" ]]; then
        active_target="$(readlink "$current_release")"
    fi

    if [[ -n "$commit_directory" && -d "$commit_directory" ]]; then
        rm -rf -- "$commit_directory"
    fi
    if [[ -n "$staging_directory" && -d "$staging_directory" ]]; then
        rm -rf -- "$staging_directory"
    fi
    if [[ -n "$uncommitted_release" && -d "$uncommitted_release" ]]; then
        candidate_target="releases/${uncommitted_release##*/}"
        if [[ "$active_target" != "$candidate_target" ]]; then
            rm -rf -- "$uncommitted_release"
        fi
    fi
    if [[ -n "$incident_destination_candidate" \
        && -f "$incident_destination_candidate" \
        && ! -L "$incident_destination_candidate" ]]; then
        rm -f -- "$incident_destination_candidate"
    fi
    if [[ -n "$incident_destination_source" \
        && -f "$incident_destination_source" \
        && ! -L "$incident_destination_source" ]]; then
        rm -f -- "$incident_destination_source"
    fi
}
trap cleanup EXIT

install -d -o root -g root -m 0755 "$install_prefix" "$releases_directory"
install -d -o root -g root -m 0755 "$state_directory"
install -d -o "$gateway_user" -g "$spool_group" -m 2750 \
    "$state_directory/inbox"
install -d -o "$gateway_user" -g "$gateway_user" -m 0700 \
    "$state_directory/commands" \
    "$state_directory/gateway" \
    "$state_directory/gateway/critical-attempts" \
    "$state_directory/gateway/critical-delivery" \
    "$state_directory/gateway/data-health-incidents" \
    "$state_directory/gateway/delivery-health-incidents" \
    "$state_directory/gateway_commands" \
    "$state_directory/acks" \
    "$state_directory/heartbeats" \
    "$state_directory/dispositions" \
    "$state_directory/quarantine"
install -d -o root -g root -m 0755 "$state_directory/outbox"
install -d -o root -g "$gateway_user" -m 2750 \
    "$state_directory/outbox/critical"
install -d -o root -g root -m 0700 \
    "$state_directory/lifecycle" \
    "$state_directory/lifecycle-progress" \
    "$state_directory/lifecycle-runtime" \
    "$state_directory/lifecycle-completions" \
    "$state_directory/lifecycle-result-quarantine" \
    "$state_directory/lifecycle-transitions"
install -d -o root -g "$user_manager_group" -m 0750 \
    "$state_directory/checkpoint-requests"
install -d -o "$user_manager" -g root -m 0750 \
    "$state_directory/checkpoint-results"
install -d -o root -g "$gateway_user" -m 2750 "$state_directory/policy"
install -d -o root -g "$command_group" -m 0750 "$socket_directory"
install -d -o root -g "$gateway_user" -m 0750 "$configuration_directory"
install -d -o root -g root -m 0755 "$unit_directory"

timing_policy_path="$configuration_directory/time.cfg"
allowed_user_ids_path="$configuration_directory/allowed_user_ids"
incident_destination_path="$configuration_directory/incident_destination.json"
if [[ -L "$timing_policy_path" \
    || ( -e "$timing_policy_path" && ! -f "$timing_policy_path" ) ]]; then
    echo "existing timing policy path is not a regular file: $timing_policy_path" >&2
    exit 1
fi
if [[ -L "$allowed_user_ids_path" || ! -f "$allowed_user_ids_path" ]]; then
    echo "incident destination requires a regular allowed-user identity file" >&2
    exit 1
fi
if [[ -L "$incident_destination_path" \
    || ( -e "$incident_destination_path" && ! -f "$incident_destination_path" ) ]]; then
    echo "existing incident destination path is not a regular file: $incident_destination_path" >&2
    exit 1
fi

incident_identity="$(python3 - "$allowed_user_ids_path" <<'PY'
import sys
from pathlib import Path

try:
    lines = Path(sys.argv[1]).read_text(encoding="utf-8").splitlines()
except OSError as error:
    raise SystemExit(f"cannot read incident destination identity: {error}")
identities = set()
for line in lines:
    value = line.strip()
    if not value:
        continue
    if not value.isascii() or not value.isdecimal():
        raise SystemExit("incident destination identity is not an exact integer")
    identity = int(value)
    if identity <= 0 or str(identity) != value:
        raise SystemExit("incident destination identity is not canonical")
    identities.add(identity)
if len(identities) != 1:
    raise SystemExit("incident destination requires exactly one allowed identity")
print(next(iter(identities)))
PY
)"
incident_destination_source="$(
    mktemp "$configuration_directory/.incident_destination.source.XXXXXX"
)"
incident_destination_candidate="$(
    mktemp "$configuration_directory/.incident_destination.candidate.XXXXXX"
)"
printf '{"chat_id":%s,"schema_version":1,"telegram_user_id":%s}\n' \
    "$incident_identity" "$incident_identity" >"$incident_destination_source"
install -o root -g root -m 0600 \
    "$incident_destination_source" "$incident_destination_candidate"
rm -f -- "$incident_destination_source"
incident_destination_source=""

temporary_environment="$configuration_directory/.guardian.env.source.$$"
candidate_environment="$configuration_directory/.guardian.env.candidate.$$"
printf 'GUARDIAN_GATEWAY_UID=%s\nUSER_MANAGER_UID=%s\n' \
    "$gateway_uid" "$user_manager_uid" >"$temporary_environment"
install -o root -g root -m 0600 \
    "$temporary_environment" "$candidate_environment"
rm -f -- "$temporary_environment"
mv -Tf -- "$candidate_environment" "$configuration_directory/guardian.env"

staging_directory="$(mktemp -d "$releases_directory/.staged.XXXXXX")"
install -d -o root -g root -m 0700 "$staging_directory"
install -d -o root -g root -m 0755 \
    "$staging_directory/survival" \
    "$staging_directory/scripts" \
    "$staging_directory/docs" \
    "$staging_directory/config" \
    "$staging_directory/services" \
    "$staging_directory/services/system"

python_modules=(
    survival/__init__.py
    survival/checkpoint.py
    survival/gateway.py
    survival/guardian.py
    survival/json_codec.py
    survival/lifecycle.py
    survival/protocol.py
    survival/records.py
    survival/system_control.py
    survival/systemd_notify.py
    survival/telegram_api.py
    survival/time_policy.py
)
for module in "${python_modules[@]}"; do
    source_path="$repository_directory/$module"
    if [[ ! -f "$source_path" ]]; then
        echo "missing source: $source_path" >&2
        exit 1
    fi
    install -o root -g root -m 0644 \
        "$source_path" "$staging_directory/$module"
done

entry_points=(
    cointelprofessional-checkpoint
    cointelprofessional-gateway
    cointelprofessional-guardian
)
for entry_point in "${entry_points[@]}"; do
    source_path="$repository_directory/scripts/$entry_point"
    if [[ ! -f "$source_path" ]]; then
        echo "missing entry point: $source_path" >&2
        exit 1
    fi
    install -o root -g root -m 0755 \
        "$source_path" "$staging_directory/scripts/$entry_point"
done

install -o root -g root -m 0644 \
    "$repository_directory/docs/operations.md" \
    "$staging_directory/docs/operations.md"
install -o root -g root -m 0644 \
    "$repository_directory/config/survival-lifecycle.json" \
    "$staging_directory/config/survival-lifecycle.json"

units=(
    cointelprofessional-survival.slice
    cointelprofessional-checkpoint.service
    cointelprofessional-gateway.service
    cointelprofessional-guardian.socket
    cointelprofessional-guardian.service
)
for unit in "${units[@]}"; do
    source_path="$repository_directory/services/system/$unit"
    if [[ ! -f "$source_path" ]]; then
        echo "missing unit: $source_path" >&2
        exit 1
    fi
    install -o root -g root -m 0644 \
        "$source_path" "$staging_directory/services/system/$unit"
done

install -d -o root -g root -m 0755 "$staging_directory"
systemd-analyze verify \
    "$staging_directory/services/system/cointelprofessional-survival.slice" \
    "$staging_directory/services/system/cointelprofessional-checkpoint.service" \
    "$staging_directory/services/system/cointelprofessional-gateway.service" \
    "$staging_directory/services/system/cointelprofessional-guardian.socket" \
    "$staging_directory/services/system/cointelprofessional-guardian.service"

symbolic_link_targets=()
symbolic_link_paths=()
for unit in "${units[@]}"; do
    symbolic_link_targets+=("$install_prefix/current/services/system/$unit")
    symbolic_link_paths+=("$unit_directory/$unit")
done
for index in "${!symbolic_link_paths[@]}"; do
    validate_symbolic_link \
        "${symbolic_link_targets[index]}" "${symbolic_link_paths[index]}"
done

# These stable links are inert until the one authoritative ``current`` value
# exists.  Publishing that value is therefore the only operational cutover.
for index in "${!symbolic_link_paths[@]}"; do
    ensure_symbolic_link \
        "${symbolic_link_targets[index]}" "${symbolic_link_paths[index]}"
done

digest="$(release_digest "$staging_directory")"
release_name="release-$digest"
release_path="$releases_directory/$release_name"
if [[ -e "$release_path" || -L "$release_path" ]]; then
    if [[ ! -d "$release_path" || -L "$release_path" \
        || "$(release_digest "$release_path")" != "$digest" ]]; then
        echo "existing release does not match its content identity" >&2
        exit 1
    fi
    rm -rf -- "$staging_directory"
    staging_directory=""
else
    mv -T -- "$staging_directory" "$release_path"
    staging_directory=""
    uncommitted_release="$release_path"
fi

# The root incident destination must exist before a release containing guardian
# command handling can become authoritative.
mv -Tf -- "$incident_destination_candidate" "$incident_destination_path"
incident_destination_candidate=""

desired_release_target="releases/$release_name"
if [[ -L "$current_release" \
    && "$(readlink "$current_release")" == "$desired_release_target" ]]; then
    uncommitted_release=""
elif [[ -e "$current_release" && ! -L "$current_release" ]]; then
    echo "existing current release path is not a symbolic link" >&2
    exit 1
else
    commit_directory="$(mktemp -d "$install_prefix/.commit.XXXXXX")"
    ln -s "$desired_release_target" "$commit_directory/current"
    mv -Tf -- "$commit_directory/current" "$current_release"
    uncommitted_release=""
    rmdir "$commit_directory"
    commit_directory=""
fi

# Mutable policy is repaired only after the candidate release has passed
# verification and the single authoritative release cutover has succeeded.
if [[ ! -e "$timing_policy_path" && ! -L "$timing_policy_path" ]]; then
    install -o root -g root -m 0644 \
        "$repository_directory/config/time.cfg" "$timing_policy_path"
fi
if [[ -L "$timing_policy_path" || ! -f "$timing_policy_path" ]]; then
    echo "existing timing policy path is not a regular file: $timing_policy_path" >&2
    exit 1
fi
chmod 0644 "$timing_policy_path"

if [[ "$enable" == true ]]; then
    systemctl daemon-reload
    systemctl enable --now \
        cointelprofessional-checkpoint.service \
        cointelprofessional-guardian.socket \
        cointelprofessional-guardian.service \
        cointelprofessional-gateway.service
fi

echo "installed Cointelprofessional survival plane at /usr/local/lib/cointelprofessional-survival"
