#!/usr/bin/env python3
"""Summarize one CointOS resource incident without dumping its large snapshot."""

import argparse
import json
import re
from pathlib import Path


def _record(value, name: str) -> dict:
    if type(value) is not dict:
        raise ValueError(f"invalid {name}")
    return value


def _count(value, name: str) -> int:
    if type(value) is not list:
        raise ValueError(f"invalid {name}")
    return len(value)


def summarize(incident: dict, control: dict, *, conclusion_exists: bool) -> dict:
    """Project bounded evidence; never infer that recovery is safe."""
    incident = _record(incident, "incident snapshot")
    control = _record(control, "resource control state")
    incident_id = incident.get("id")
    resources = _record(incident.get("resources"), "incident resources")
    executor = _record(incident.get("executor_reconciliation"), "executor reconciliation")
    proxy = _record(executor.get("proxy"), "proxy reconciliation")
    unload = _record(incident.get("unload"), "model unload")
    emergency_load = _record(incident.get("emergency_model_load"), "emergency model load")
    gate = control.get("emergency_work_gate")
    gate = gate if type(gate) is dict else {}
    current = control.get("incident_id") == incident_id
    return {
        "id": incident_id,
        "detected_at": incident.get("detected_at"),
        "reason": incident.get("reason"),
        "context_boundary": incident.get("context_boundary"),
        "affected_counts": {
            "active_jobs": _count(incident.get("active_jobs"), "active jobs"),
            "active_control_turns": _count(incident.get("active_control_turns"),
                                           "active control turns"),
            "interrupted_jobs": _count(incident.get("interrupted_jobs"),
                                       "interrupted jobs"),
            "retained_proxy_leases_at_snapshot": _count(
                proxy.get("retained"), "retained proxy leases"),
        },
        "resources_at_detection": {key: resources.get(key) for key in (
            "memory_available_gb", "gtt_used_gb", "swap_used_gb",
            "memory_full_avg10", "oom_kills")},
        "snapshot_actions": {
            "model_unload_ok": unload.get("ok"),
            "emergency_model_load_ok": emergency_load.get("ok"),
            "executor_reconciliation_ok": executor.get("ok"),
            "executor_blockers": _count(executor.get("blockers"),
                                        "executor blockers"),
        },
        "conclusion_exists": conclusion_exists,
        "current": ({"mode": control.get("mode"),
                     "phase": control.get("emergency_phase"),
                     "work_gate": gate.get("mode"),
                     "survivor": control.get("sole_survivor_job"),
                     "error": control.get("emergency_error")}
                    if current else None),
        "recovery_safety": "not assessed",
    }


def report(root: Path, incident_id: str | None) -> dict:
    state = root / "state"
    control = _record(json.loads((state / "resource-control.json").read_text(
        encoding="utf-8")), "resource control state")
    incident_id = incident_id or control.get("incident_id")
    if (type(incident_id) is not str
            or re.fullmatch(r"[A-Za-z0-9][A-Za-z0-9_-]{0,127}", incident_id) is None):
        raise ValueError("invalid incident ID")
    base = state / "resource-incidents" / incident_id
    incident = _record(json.loads(base.with_suffix(".json").read_text(
        encoding="utf-8")), "incident snapshot")
    if incident.get("id") != incident_id:
        raise ValueError("incident snapshot identity mismatch")
    return summarize(incident, control,
                     conclusion_exists=Path(f"{base}-conclusion.md").is_file())


def main() -> None:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("incident_id", nargs="?", help="default: current incident")
    parser.add_argument("--root", type=Path, default=Path.home() / ".CointOS")
    parser.add_argument("--json", action="store_true", help="emit machine-readable JSON")
    args = parser.parse_args()
    try:
        result = report(args.root, args.incident_id)
    except (OSError, ValueError, TypeError) as error:
        parser.exit(2, f"cointos-incident: {error}\n")
    if args.json:
        print(json.dumps(result, indent=2, sort_keys=True))
        return
    print(f"incident={result['id']} detected={result['detected_at']}")
    print(f"reason: {result['reason']}")
    print("at detection: " + ", ".join(
        f"{key}={value}" for key, value in result["resources_at_detection"].items()))
    print("affected: " + ", ".join(
        f"{key}={value}" for key, value in result["affected_counts"].items()))
    print("snapshot actions: " + ", ".join(
        f"{key}={value}" for key, value in result["snapshot_actions"].items()))
    print(f"conclusion_exists={result['conclusion_exists']} "
          f"recovery_safety={result['recovery_safety']}")
    if result["current"] is not None:
        print("current: " + ", ".join(
            f"{key}={value}" for key, value in result["current"].items()))


if __name__ == "__main__":
    main()
