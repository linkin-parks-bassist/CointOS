[Unit]
Description=Allowlisted Telegram gateway for local agent jobs
After=network-online.target agent-models.service
Wants=network-online.target agent-models.service
[Service]
Slice=control.slice
ExecStart=%h/agent-ecosystem/scripts/telegram-gateway
WorkingDirectory=%h/agent-ecosystem
EnvironmentFile=%h/.config/agent-ecosystem/telegram.env
Environment=AGENT_TELEGRAM_FIRST_RESPONSE_MODEL=Qwen3.5-4B-GGUF
Environment=COINTOS_RUNTIME_ROOT=%h/.CointOS
Restart=on-failure
RestartSec=5
CPUWeight=1000
IOWeight=1000
MemoryLow=512M
ManagedOOMPreference=avoid
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=%h/.CointOS
[Install]
WantedBy=default.target
