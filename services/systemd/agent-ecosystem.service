[Unit]
Description=Process local agent ecosystem inbox once

[Service]
Type=oneshot
WorkingDirectory=%h/agent-ecosystem
ExecStart=%h/agent-ecosystem/scripts/ecosystem run-once
ExecStart=%h/agent-ecosystem/scripts/ecosystem prepare-next
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=%h/agent-ecosystem
