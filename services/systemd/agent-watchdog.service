[Unit]
Description=Inspect agent ecosystem health and enqueue periodic stewardship
[Service]
Type=oneshot
Slice=background.slice
Nice=10
CPUWeight=10
IOWeight=10
IOSchedulingClass=idle
WorkingDirectory=%h/agent-ecosystem
Environment=COINTOS_RUNTIME_ROOT=%h/.CointOS
ExecStart=%h/agent-ecosystem/scripts/watchdog
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=%h/.CointOS
