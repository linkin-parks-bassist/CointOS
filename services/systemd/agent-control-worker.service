[Unit]
Description=Process durable Telegram control turns outside the polling path
After=network-online.target agent-models.service
Wants=network-online.target agent-models.service

[Service]
Slice=control.slice
ExecStart=%h/Projects/CointOS/scripts/control-worker
WorkingDirectory=%h/Projects/CointOS
EnvironmentFile=%h/.config/agent-ecosystem/telegram.env
Environment=AGENT_TELEGRAM_MODEL=Qwen3.8-27B-GGUF
Environment=AGENT_CONTROL_WORKERS=2
Environment=COINTOS_RUNTIME_ROOT=%h/.CointOS
Restart=on-failure
RestartSec=5
CPUWeight=1000
IOWeight=1000
MemoryLow=512M
ManagedOOMPreference=avoid
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=%h/.CointOS

[Install]
WantedBy=default.target
