[Unit]
Description=Protect desktop and chatbot from inference memory pressure
After=network-online.target
Wants=network-online.target

[Service]
Slice=control.slice
ExecStart=%h/Projects/CointOS/scripts/resource-control run
WorkingDirectory=%h/Projects/CointOS
Environment=COINTOS_RUNTIME_ROOT=%h/.CointOS
Restart=always
RestartSec=1
CPUWeight=1000
IOWeight=1000
MemoryMin=256M
MemoryLow=512M
ManagedOOMPreference=avoid
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=%h/Projects/CointOS

[Install]
WantedBy=default.target
