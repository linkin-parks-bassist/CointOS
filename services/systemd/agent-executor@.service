[Unit]
Description=Process local agent tasks in executor lane %i
BindsTo=agent-executors.target
PartOf=agent-executors.target
After=agent-executors.target

[Service]
Type=oneshot
Slice=background.slice
Nice=10
CPUWeight=10
IOWeight=10
IOSchedulingClass=idle
WorkingDirectory=%h/Projects/CointOS
EnvironmentFile=-%h/.config/agent-ecosystem/telegram.env
Environment=COINTOS_RUNTIME_ROOT=%h/.CointOS
ExecStart=%h/Projects/CointOS/scripts/executor
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=false
RestrictSUIDSGID=true
