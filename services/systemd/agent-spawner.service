[Unit]
Description=Spawn autonomous agents into spare capacity
[Service]
Type=oneshot
Slice=background.slice
Nice=10
CPUWeight=10
IOWeight=10
IOSchedulingClass=idle
WorkingDirectory=%h/Projects/CointOS
Environment=COINTOS_RUNTIME_ROOT=%h/.CointOS
ExecStart=%h/Projects/CointOS/scripts/spawner
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=%h/.CointOS
