[Unit]
Description=Cointelprofessional guardian - peer-authenticated lifecycle controller
StartLimitIntervalSec=0

[Service]
Type=notify
NotifyAccess=main
User=root
Group=cointelprofessional_command
Slice=cointelprofessional-survival.slice
Sockets=cointelprofessional-guardian.socket
Restart=always
RestartSec=250ms
WatchdogSec=10s
RuntimeDirectory=cointelprofessional
RuntimeDirectoryMode=0750
RuntimeDirectoryPreserve=yes
ExecStart=/usr/bin/python3 -m survival.guardian
WorkingDirectory=/usr/local/lib/cointelprofessional-survival/current
EnvironmentFile=/etc/cointelprofessional/guardian.env
Environment=GUARDIAN_SOCKET_PATH=/run/cointelprofessional/guardian.sock
Environment=SURVIVAL_STORE_DIR=/var/lib/cointelprofessional
Environment=TIME_CONFIG_PATH=/etc/cointelprofessional/time.cfg
Environment=LIFECYCLE_CATALOG_PATH=/usr/local/lib/cointelprofessional-survival/current/config/survival-lifecycle.json
Environment=AGENT_STATE_DIR=/home/david/agent-ecosystem/state
Environment=INCIDENT_DESTINATION_PATH=/etc/cointelprofessional/incident_destination.json
ReadOnlyPaths=/usr/local/lib/cointelprofessional-survival /etc/cointelprofessional/guardian.env /etc/cointelprofessional/incident_destination.json /etc/cointelprofessional/time.cfg /sys/fs/cgroup
ReadWritePaths=/var/lib/cointelprofessional/lifecycle /var/lib/cointelprofessional/lifecycle-progress /var/lib/cointelprofessional/lifecycle-runtime /var/lib/cointelprofessional/lifecycle-completions /var/lib/cointelprofessional/lifecycle-result-quarantine /var/lib/cointelprofessional/policy /var/lib/cointelprofessional/outbox/critical /run/cointelprofessional /home/david/agent-ecosystem/state
PrivateTmp=true
PrivateDevices=true
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=read-only
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6

[Install]
WantedBy=multi-user.target
