+std::shared_ptr<const TextModelRunner> InferenceBackend::release_runner() {
+#if defined(ENGINE_ENABLE_HIP)
+  std::shared_ptr<const Impl::State> state;
+  {
+    const std::lock_guard<std::mutex> lock(impl_->state_mutex);
+    state = impl_->state;
+    if (!state || !state->external_runner)
+      throw std::logic_error(
+          "external control requires a loaded dense Qwen runner");
+    for (const auto& session : state->scheduler->SessionStates())
+      if (session.processing)
+        throw std::logic_error("cannot release an active runner");
+    impl_->state.reset();
+  }
+  auto runner = state->external_runner;
+  state.reset();  // Join scheduler and release its sessions before external
+                  // work.
+  return runner;
+#else
+  throw std::logic_error("external control requires a HIP build");
+#endif
+}
