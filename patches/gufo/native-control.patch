+std::optional<std::string> ParseControlChat(const json::Value& body,
+                                            ChatRequest* chat) {
+  const auto* messages = body.find("messages");
+  if (!messages || !messages->is_array() || messages->empty())
+    return "messages must be a nonempty array";
+  core::ImageReadBudget budget;
+  budget.accepts_images = false;
+  std::string error;
+  for (const auto& item : messages->items()) {
+    tokenization::ChatMessage message;
+    if (!ParseMessage(item, &message, budget, &error))
+      return error;
+    chat->messages.push_back(std::move(message));
+  }
+  if (!ParseTools(body.find("tools"), &chat->tools, &error) ||
+      !ParseReasoningOptions(body, &chat->reasoning, &error))
+    return error;
+  return std::nullopt;
+}
