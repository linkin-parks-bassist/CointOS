+    // Experimental trailer after the native target state. Older readers ignore it.
+    static constexpr uint64_t mtp_slot_magic = 0x31544f4c5350544dULL;
+
+    size_t save_mtp_slot(const std::string & path, llama_seq_id id) {
+        std::vector<uint8_t> boundary;
+        if (!common_speculative_get_state(spec.get(), id, boundary) || boundary.empty()) {
+            throw std::runtime_error("MTP boundary state unavailable");
+        }
+        std::vector<uint8_t> draft(llama_state_seq_get_size(ctx_dft, id));
+        if (llama_state_seq_get_data(ctx_dft, draft.data(), draft.size(), id) != draft.size()) {
+            throw std::runtime_error("Cannot save MTP draft state");
+        }
+        const uint64_t header[] = { mtp_slot_magic, 1, draft.size(), boundary.size() };
+        std::ofstream file(path, std::ios::binary | std::ios::app);
+        file.exceptions(std::ios::failbit | std::ios::badbit);
+        file.write(reinterpret_cast<const char *>(header), sizeof(header));
+        file.write(reinterpret_cast<const char *>(draft.data()), draft.size());
+        file.write(reinterpret_cast<const char *>(boundary.data()), boundary.size());
+        file.close();
+        return sizeof(header) + draft.size() + boundary.size();
+    }
+
+    size_t restore_mtp_slot(const std::string & path, size_t target_bytes, llama_seq_id id) {
+        std::ifstream file(path, std::ios::binary | std::ios::ate);
+        file.exceptions(std::ios::failbit | std::ios::badbit);
+        const auto file_bytes = (uint64_t) file.tellg();
+        if (file_bytes < target_bytes) {
+            throw std::runtime_error("Truncated MTP slot state");
+        }
+        if (file_bytes == target_bytes) {
+            // Legacy snapshots have no draft history. Do not inherit another owner's state.
+            llama_memory_seq_rm(llama_get_memory(ctx_dft), id, -1, -1);
+            std::vector<uint8_t> boundary;
+            if (common_speculative_get_state(spec.get(), id, boundary)) {
+                std::fill(boundary.begin(), boundary.end(), 0);
+                common_speculative_set_state(spec.get(), id, boundary);
+            }
+            SRV_WRN("%s", "legacy target-only snapshot: MTP draft history is cold\n");
+            return 0;
+        }
+        uint64_t header[4];
+        if (file_bytes - target_bytes < sizeof(header)) {
+            throw std::runtime_error("Truncated MTP slot trailer");
+        }
+        file.seekg(target_bytes);
+        file.read(reinterpret_cast<char *>(header), sizeof(header));
+        const uint64_t payload_bytes = file_bytes - target_bytes - sizeof(header);
+        const uint64_t boundary_bytes = (uint64_t) llama_model_n_embd_out(llama_get_model(ctx_dft)) * sizeof(float);
+        if (header[0] != mtp_slot_magic || header[1] != 1 || header[3] != boundary_bytes ||
+                header[2] > payload_bytes || header[3] != payload_bytes - header[2]) {
+            throw std::runtime_error("Invalid MTP slot trailer");
+        }
+        std::vector<uint8_t> draft(header[2]), boundary(header[3]);
+        file.read(reinterpret_cast<char *>(draft.data()), draft.size());
+        file.read(reinterpret_cast<char *>(boundary.data()), boundary.size());
+        if (llama_state_seq_set_data(ctx_dft, draft.data(), draft.size(), id) != draft.size()) {
+            throw std::runtime_error("Cannot restore MTP draft state");
+        }
+        common_speculative_set_state(spec.get(), id, boundary);
+        return sizeof(header) + payload_bytes;
     }
 
