[Unit]
Description=CointOS Coin: the user's Telegram remote control
After=network-online.target @DAEMON_UNIT@
StartLimitIntervalSec=0

[Service]
Type=simple
WorkingDirectory=@STATION@
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONPATH=@ROOT@
Environment=KT_ACTOR=cointos-coin
Environment=COINTEL=@COINTEL@
Environment=PATH=@ROOT@/bin:@HOME@/.local/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=/usr/bin/python3 -m cointos.coin
Restart=always
RestartSec=@SERVICE_RESTART_SECONDS@

[Install]
WantedBy=default.target
